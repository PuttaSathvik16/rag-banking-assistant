# Copy this file to .env and fill in your own key. Never commit .env.
GOOGLE_API_KEY=your_gemini_api_key_here

# Model IDs (verify these are still live in Google AI Studio before your run)
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_COMPARISON_MODEL_A=gemini-2.5-flash-lite
GEMINI_COMPARISON_MODEL_B=gemini-2.5-flash
